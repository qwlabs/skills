{
  "env": {
    "PONYTAIL_DEFAULT_MODE": "ultra",
    "PONYTAIL_HIDE_STATUS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "typescript-lsp@anthropic-plugin-directory": true,
    "ponytail@ponytail": true
  },
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "alwaysLoad": true
    }
  }
}
